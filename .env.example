# ==============================
# 基础安全配置
# ==============================

# Flask 会话加密密钥。必须改成足够长的随机字符串，建议 32 位以上。
APP_SECRET=replace-with-a-long-random-string

# 后台首次初始化时创建的管理员账号。用户已存在后，修改此项不会自动改名。
ADMIN_USERNAME=admin

# 后台首次初始化时创建的管理员密码。用户已存在后，修改此项不会自动重置密码。
ADMIN_PASSWORD=replace-with-admin-password


# ==============================
# PostgreSQL / Redis
# ==============================

# PostgreSQL 连接地址。后台会自动建表，但数据库本身需要提前创建。
# 格式：postgresql://用户名:密码@主机:端口/数据库名
# 如果 vpn-admin 使用 ADMIN_NETWORK_MODE=host，127.0.0.1 指服务器宿主机。
DATABASE_URL=postgresql://db_user:db_password@127.0.0.1:5432/vpn_admin

# Redis 连接地址，用于登录会话、任务锁、订阅 token 校验缓存。
# 格式：redis://:密码@主机:端口/库编号
# Redis 没有密码时可写：redis://127.0.0.1:6379/0
REDIS_URL=redis://:redis_password@127.0.0.1:6379/0


# ==============================
# 后台 Web 服务
# ==============================

# 后台监听地址。容器内通常保持 0.0.0.0。
HOST=0.0.0.0

# 后台监听端口。使用 host 网络时，这就是服务器直接暴露的端口。
PORT=19090

# 容器内项目目录。通常不需要改；compose 会把当前目录挂载到这里。
VPN_DIR=/app/vpn

# 后台访问前缀。比如 /sub/clash 表示后台首页为 http://服务器:端口/sub/clash。
# 如果你想放到根路径，可改成空值：URL_PREFIX=
URL_PREFIX=/sub/clash

# 启动时等待 PostgreSQL / Redis 就绪的最长秒数。
STARTUP_WAIT_SECONDS=90

# 后台服务运行方式。
# simple：单进程 Flask，内存占用低，适合自用。
# gunicorn：生产 WSGI 服务，适合多人使用或更高并发。
ADMIN_SERVER=simple

# 自更新时使用的 updater 镜像。默认留空，会自动使用当前 vpn-admin 容器的镜像。
# 只有在自动识别失败时才需要手动填写，例如 vpn-vpn-admin:latest。
ADMIN_UPDATER_IMAGE=

# 使用 ADMIN_SERVER=gunicorn 时生效，表示 gunicorn worker 数。
GUNICORN_WORKERS=1

# 使用 ADMIN_SERVER=gunicorn 时生效，表示每个 worker 的线程数。
GUNICORN_THREADS=2

# 使用 ADMIN_SERVER=gunicorn 时生效，表示请求超时时间，单位秒。
GUNICORN_TIMEOUT=120

# 限制 malloc arena 数量，降低 Python 进程静默内存占用。
MALLOC_ARENA_MAX=2

# 开启 Python 优化模式，去掉 assert 和部分调试信息，略微降低资源占用。
PYTHONOPTIMIZE=2

# 不写入 .pyc 文件，减少容器内运行态文件。
PYTHONDONTWRITEBYTECODE=1

# 拉取其他 vpn-admin 订阅源时的单个请求超时时间，单位秒。
# 失败、错误、超时都会跳过该订阅源，不影响本机订阅返回。
EXTERNAL_SUBSCRIPTION_TIMEOUT=4

# 单个外部订阅源允许下载的最大字节数。默认 1MB，避免异常大文件拖垮服务。
EXTERNAL_SUBSCRIPTION_MAX_BYTES=1048576

# 外部订阅的热缓存时间，单位秒。缓存命中时不会重复请求远端，也不会反复写失败日志。
EXTERNAL_SUBSCRIPTION_CACHE_TTL=300

# 外部订阅的陈旧缓存保留时间，单位秒。远端临时超时时会优先回退到最近一次成功缓存。
EXTERNAL_SUBSCRIPTION_STALE_TTL=86400

# 同一个外部订阅失败日志的最短写入间隔，单位秒，避免客户端频繁拉取时把审计日志刷爆。
EXTERNAL_SUBSCRIPTION_FAILURE_LOG_COOLDOWN=1800

# 单个外部订阅连续失败多少次后自动暂停。暂停后不会继续请求，直到管理员手动恢复。
EXTERNAL_SUBSCRIPTION_MAX_FAILURES=10

# 外部订阅请求使用的代理地址。留空表示直连。
# 例如 http://127.0.0.1:7890
EXTERNAL_SUBSCRIPTION_PROXY=


# ==============================
# 版本检测与在线更新
# ==============================

# 源码仓库目录。推荐部署结构是运行目录下再 clone 一份 wg-clash-admin 源码仓库。
# 示例：/home/wzh/vpn/wg-clash-admin 会在容器内对应 /app/vpn/wg-clash-admin。
UPDATE_REPO_DIR=/app/vpn/wg-clash-admin

# 开源源码仓库地址。源码目录不存在时，后台检查版本会尝试自动 clone 这个仓库。
UPDATE_REPO_URL=https://github.com/jqmzfj/wg-clash-admin.git

# 检测和更新使用的 Git 分支。通常是 main；如果你的仓库使用 master 或其他分支，请改成对应分支名。
UPDATE_BRANCH=main

# 版本号文件名。运行目录和源码仓库里都应该有这个文件，文件内容只写当前版本号。
UPDATE_VERSION_FILE=VERSION

# 自动检测 GitHub 是否有新版本的间隔，单位秒。18000 秒等于 5 小时。
UPDATE_CHECK_INTERVAL_SECONDS=18000

# 是否在在线更新时同步覆盖 docker-compose.yml。
# false：默认安全模式，不覆盖服务器本机 compose 配置。
# true：同步 compose 模板，适合你确认新版本必须更新 compose 时使用；覆盖前会自动备份。
UPDATE_SYNC_COMPOSE=false

# 点击更新时，从源码仓库同步覆盖到运行目录的白名单路径。
# 不要把 .env、vpn-config、clash-config.yaml、run.log 放进这里，避免覆盖运行数据和敏感配置。
UPDATE_SYNC_PATHS=admin,run.sh,generate_clash_yaml.py,README.md,.env.example,VERSION


# ==============================
# Docker 容器命名与网络
# ==============================

# WireGuard 容器名称。后台重建容器时默认操作 docker compose 中的 wireguard 服务。
WIREGUARD_CONTAINER_NAME=wireguard

# 后台容器名称。
ADMIN_CONTAINER_NAME=vpn-admin

# 后台容器网络模式。
# host：容器直接使用宿主机网络，访问 127.0.0.1 可连接宿主机上的 PostgreSQL / Redis。
# bridge：桥接模式，需要自行配置端口映射和数据库地址。
ADMIN_NETWORK_MODE=host


# ==============================
# WireGuard 配置
# ==============================

# linuxserver/wireguard 容器内文件所属用户 ID。通常用服务器普通用户的 UID。
PUID=1000

# linuxserver/wireguard 容器内文件所属用户组 ID。通常用服务器普通用户的 GID。
PGID=1000

# 容器时区。
TZ=Asia/Shanghai

# WireGuard 对外访问地址，填写服务器公网 IP 或域名。
SERVERURL=your.server.ip.or.domain

# WireGuard 对外 UDP 端口。被墙网络建议优先测试 9999 以下低位端口，例如 1234、585，必要时可试 443。
# compose 会映射为 SERVERPORT:51820/udp。
SERVERPORT=1234

# WireGuard 客户端数量。后台页面也可以修改此值。
PEERS=10

# 本机节点名前缀。生成 Clash 订阅时，peer1/peer2 会显示为这个前缀加序号。
# 例如 LOCAL_NODE_PREFIX=香港，则节点名为 香港1、香港2。
LOCAL_NODE_PREFIX=peer

# 客户端 DNS。可填公共 DNS 或内网 DNS。
PEERDNS=1.1.1.1

# WireGuard 内部网段。已有配置生成后不建议随意修改。
INTERNAL_SUBNET=10.66.66.0/24


# ==============================
# AWG 测试追加配置（可整段追加到你现有 .env 最底部）
# ==============================

# WireGuard 服务端镜像。默认仍然兼容旧配置，不追加这一行时会继续使用 linuxserver/wireguard。
# 只有在测试 AmneziaWG 时才需要追加。
WIREGUARD_IMAGE=linuxserver/wireguard:latest

# ==============================
# AmneziaWG 混淆参数（可选）
# ==============================

# 以下参数留空时，生成的 Clash/Mihomo 订阅仍为普通 wireguard 节点。
# 填入后会额外输出 amnezia-wg-option，便于测试支持 AWG 的客户端。
# 这些参数需要和服务端实际配置保持一致。
# S1-S3 建议填 0-64，S4 建议填 0-32；H1-H4 可填单个整数，也可填 v2.0 的区间字符串，例如 123456-123500。
# I1-I5 可填 CPS 字符串，例如 <b 0xf6ab3267fa><r 20>，请按服务端实际规则填写。
AWG_JC=
AWG_JMIN=
AWG_JMAX=
AWG_S1=
AWG_S2=
AWG_S3=
AWG_S4=
AWG_H1=
AWG_H2=
AWG_H3=
AWG_H4=
AWG_I1=
AWG_I2=
AWG_I3=
AWG_I4=
AWG_I5=
